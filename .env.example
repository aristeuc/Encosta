# Copie este ficheiro para .env e preencha os valores.

# --- Base de dados -----------------------------------------------------
# Local (docker compose up -d db):
DATABASE_URL="postgresql://obra:obra@localhost:5432/obra_tracker?schema=public"
# Produção: string de ligação do Neon/Vercel Postgres/Supabase, etc.

# --- Sessão / autenticação ----------------------------------------------
# Gere um valor aleatório forte: openssl rand -base64 32
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# --- Envio de email (notificações de prazos) ----------------------------
# Qualquer servidor SMTP (Gmail, SendGrid, Resend SMTP, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="senha-de-app"
SMTP_FROM="Encosta Obras <seu-email@gmail.com>"

# --- WhatsApp (Twilio WhatsApp API) --------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Número do remetente Twilio no formato WhatsApp, ex: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Google Drive ---------------------------------------------------------
# Credenciais de uma Service Account do Google Cloud com a Drive API ativada
# e partilhada com a pasta/Drive onde os documentos serão guardados.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# ID da pasta raiz do Google Drive onde as pastas de cada obra serão criadas
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# --- Cron de notificações --------------------------------------------------
# Segredo partilhado para autenticar o endpoint /api/cron/deadline-check
CRON_SECRET="troque-por-um-valor-aleatorio"
